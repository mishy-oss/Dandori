{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dandori",
  "compatibility_date": "2026-10-06",
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PUSH_DEVICES", "class_name": "PushDevice" }
    ]
  },
  "exports": {
    "PushDevice": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // 作業ブランチのプレビューでも通知予定の保存先を利用する。
  // script_name を指定せず、各プレビュー専用の領域を自動作成する。
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "PUSH_DEVICES", "class_name": "PushDevice" }
      ]
    }
  }
}
